# ── CampusNetwork (Cenet) Backend Environment Template ─────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env to Git!

# Core Django
SECRET_KEY=replace-with-a-long-random-50-char-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite default if omitted; PostgreSQL or MySQL recommended in production)
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/campusnetwork
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/campusnetwork

# Frontend Origin & CORS/CSRF (set to your live domain in production!)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Email Provider (console backend for local dev; SMTP/SendGrid/SES in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CampusNetwork <no-reply@campusnetwork.edu.ng>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password

# Optional FormSubmit integration (for non-secret administrative / SUG approval notices only)
# Password reset codes and email verification tokens NEVER use FormSubmit.
FORMSUBMIT_ENABLED=False
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax

# Google Sign-In (optional; requires google-auth package)
GOOGLE_CLIENT_ID=

# Private PDF & Verification Document Storage (must be outside MEDIA_ROOT!)
LIBRARY_PRIVATE_ROOT=
LIBRARY_MAX_PDF_BYTES=15728640

# Optional S3 / Cloudinary off-root media storage
USE_S3_MEDIA=False
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=

# Verified Student Entitlements (configurable)
ORDINARY_MAX_POST_WORDS=300
VERIFIED_MAX_POST_WORDS=1200
USERNAME_COOLDOWN_DAYS=14
VERIFIED_COMMENT_BOOST=1.5

# Advertising Payments (deferred — keep False until Paystack is live & verified)
AD_PAYMENTS_ENABLED=False
PAYSTACK_SECRET_KEY=

# Rate Limits
APPLICATIONS_THROTTLE=10/hour
AUTH_LOGIN_THROTTLE=20/minute
AUTH_REGISTER_THROTTLE=10/hour
PASSWORD_RESET_THROTTLE=10/hour
EMAIL_VERIFY_THROTTLE=10/hour
AD_TRACKING_THROTTLE=120/minute
