# ── CampusNetwork (Cenet) Frontend Environment Template ────────────────────
# Copy this file to .env (local) or configure in your hosting dashboard (Vercel/Netlify).

# Backend API URL (NEVER leave localhost in production!)
VITE_API_URL=http://127.0.0.1:8000/api

# Optional Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
